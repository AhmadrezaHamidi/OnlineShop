<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="ignoreFailedSources" value="true" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalBase" value="/src/local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LocalBase">
      <package pattern="AhmadBase.*" />
      <package pattern="Ahmad.Base.*" />
      <package pattern="Ahmad.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
